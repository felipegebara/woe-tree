import numpy as npimport pandas as pd

from dataclasses import dataclassfrom sklearn.isotonic import IsotonicRegression

@dataclassclass Node:depth: intfeature: str = Nonethreshold: float = Noneleft: object = Noneright: object = Noneproba_bad: float = Nonen_samples: int = Nonen_bads: int = Noneis_leaf: bool = False

class WOEPolicyTreeClassifier:def init(self,max_depth=3,min_samples_leaf=500,min_bad_leaf=30,min_good_leaf=30,max_bins=10,min_bad_rate_diff=0.02,criterion="woe_gain",monotonic=False,monotonic_constraints=None,leaf_monotonic=False,leaf_monotonic_direction="increasing",leaf_sort_method="empirical_bad_rate",  # novorandom_state=42):self.max_depth = max_depthself.min_samples_leaf = min_samples_leafself.min_bad_leaf = min_bad_leafself.min_good_leaf = min_good_leafself.max_bins = max_binsself.min_bad_rate_diff = min_bad_rate_diffself.criterion = criterionself.monotonic = monotonicself.monotonic_constraints = monotonic_constraints or {}self.leaf_monotonic = leaf_monotonicself.leaf_monotonic_direction = leaf_monotonic_directionself.leaf_sort_method = leaf_sort_methodself.random_state = random_state

    self.root = None
    self.features_ = None
    self.global_bad_rate_ = None
    self.leaf_pds_before_ = None
    self.leaf_pds_after_ = None

def _woe_score(self, y_left, y_right):
    eps = 1e-6

    bad_left = y_left.mean()
    bad_right = y_right.mean()

    good_left = 1 - bad_left
    good_right = 1 - bad_right

    woe_left = np.log((good_left + eps) / (bad_left + eps))
    woe_right = np.log((good_right + eps) / (bad_right + eps))

    return abs(woe_left - woe_right)

def _split_score(self, y_left, y_right):
    bad_diff = abs(y_left.mean() - y_right.mean())

    if self.criterion == "bad_rate_gain":
        return bad_diff

    if self.criterion == "woe_gain":
        return self._woe_score(y_left, y_right)

    if self.criterion == "hybrid":
        return bad_diff + 0.5 * self._woe_score(y_left, y_right)

    raise ValueError(
        "criterion deve ser: 'bad_rate_gain', 'woe_gain' ou 'hybrid'"
    )

def _valid_leaf(self, y):
    n = len(y)
    bads = y.sum()
    goods = n - bads

    return (
        n >= self.min_samples_leaf
        and bads >= self.min_bad_leaf
        and goods >= self.min_good_leaf
    )

def _candidate_thresholds(self, x):
    x = pd.Series(x).dropna()

    if x.nunique() <= 1:
        return []

    try:
        bins = pd.qcut(
            x,
            q=min(self.max_bins, x.nunique()),
            duplicates="drop"
        )

        thresholds = sorted([
            interval.right for interval in bins.cat.categories[:-1]
        ])

    except Exception:
        thresholds = sorted(x.unique())[:-1]

    return thresholds

def _is_monotonic_split_valid(self, feature, y_left, y_right):
    if not self.monotonic:
        return True

    direction = self.monotonic_constraints.get(feature, 0)

    if direction == 0:
        return True

    bad_left = y_left.mean()
    bad_right = y_right.mean()

    if direction == 1:
        return bad_right >= bad_left

    if direction == -1:
        return bad_right <= bad_left

    return True

def _best_split(self, X, y):
    best_feature = None
    best_threshold = None
    best_score = -np.inf

    for feature in self.features_:
        thresholds = self._candidate_thresholds(X[feature])

        for threshold in thresholds:
            left_mask = X[feature] <= threshold
            right_mask = ~left_mask

            y_left = y[left_mask]
            y_right = y[right_mask]

            if not self._valid_leaf(y_left):
                continue

            if not self._valid_leaf(y_right):
                continue

            if not self._is_monotonic_split_valid(feature, y_left, y_right):
                continue

            bad_rate_diff = abs(y_left.mean() - y_right.mean())

            if bad_rate_diff < self.min_bad_rate_diff:
                continue

            score = self._split_score(y_left, y_right)

            if score > best_score:
                best_score = score
                best_feature = feature
                best_threshold = threshold

    return best_feature, best_threshold, best_score

def _build_tree(self, X, y, depth):
    node = Node(
        depth=depth,
        proba_bad=float(y.mean()),
        n_samples=len(y),
        n_bads=int(y.sum())
    )

    if depth >= self.max_depth:
        node.is_leaf = True
        return node

    if y.nunique() == 1:
        node.is_leaf = True
        return node

    feature, threshold, score = self._best_split(X, y)

    if feature is None:
        node.is_leaf = True
        return node

    left_mask = X[feature] <= threshold
    right_mask = ~left_mask

    node.feature = feature
    node.threshold = threshold
    node.left = self._build_tree(X[left_mask], y[left_mask], depth + 1)
    node.right = self._build_tree(X[right_mask], y[right_mask], depth + 1)

    return node

def _get_leaves_in_order(self, node, leaves):
    if node is None:
        return

    if node.is_leaf:
        leaves.append(node)
        return

    self._get_leaves_in_order(node.left, leaves)
    self._get_leaves_in_order(node.right, leaves)

def _sort_leaves_for_monotonicity(self, leaves):
    if self.leaf_sort_method == "tree_order":
        return leaves

    if self.leaf_sort_method == "proba_bad":
        return sorted(
            leaves,
            key=lambda leaf: leaf.proba_bad
        )

    if self.leaf_sort_method == "empirical_bad_rate":
        return sorted(
            leaves,
            key=lambda leaf: leaf.n_bads / leaf.n_samples
        )

    raise ValueError(
        "leaf_sort_method deve ser: "
        "'tree_order', 'proba_bad' ou 'empirical_bad_rate'"
    )

def _apply_leaf_monotonicity(self):
    leaves = []
    self._get_leaves_in_order(self.root, leaves)

    if len(leaves) <= 1:
        return

    if self.leaf_monotonic_direction not in ["increasing", "decreasing"]:
        raise ValueError(
            "leaf_monotonic_direction deve ser 'increasing' ou 'decreasing'"
        )

    leaves = self._sort_leaves_for_monotonicity(leaves)

    pds = np.array([leaf.proba_bad for leaf in leaves])
    weights = np.array([leaf.n_samples for leaf in leaves])
    x = np.arange(len(leaves))

    increasing = self.leaf_monotonic_direction == "increasing"

    iso = IsotonicRegression(
        increasing=increasing,
        out_of_bounds="clip"
    )

    pds_adj = iso.fit_transform(
        x,
        pds,
        sample_weight=weights
    )

    self.leaf_pds_before_ = pds.copy()
    self.leaf_pds_after_ = pds_adj.copy()

    for leaf, pd_adj in zip(leaves, pds_adj):
        leaf.proba_bad = float(pd_adj)

def fit(self, X, y):
    X = pd.DataFrame(X).copy()
    y = pd.Series(y).copy()

    self.features_ = list(X.columns)
    self.global_bad_rate_ = float(y.mean())

    self.root = self._build_tree(X, y, depth=0)

    if self.leaf_monotonic:
        self._apply_leaf_monotonicity()

    return self

def _predict_one_proba(self, row, node):
    if node.is_leaf:
        return node.proba_bad

    if row[node.feature] <= node.threshold:
        return self._predict_one_proba(row, node.left)

    return self._predict_one_proba(row, node.right)

def predict_proba(self, X):
    if self.root is None:
        raise ValueError("Modelo não treinado. Rode .fit(X, y) antes.")

    X = pd.DataFrame(X).copy()

    probs_bad = X.apply(
        lambda row: self._predict_one_proba(row, self.root),
        axis=1
    ).values

    probs_good = 1 - probs_bad

    return np.column_stack([probs_good, probs_bad])

def predict(self, X, threshold=0.5):
    proba_bad = self.predict_proba(X)[:, 1]
    return (proba_bad >= threshold).astype(int)

def print_rules(self, node=None, conditions=None):
    if self.root is None:
        raise ValueError("Modelo não treinado. Rode .fit(X, y) antes.")

    if node is None:
        node = self.root

    if conditions is None:
        conditions = []

    if node.is_leaf:
        regra = " AND ".join(conditions) if conditions else "TODOS"
        print(
            f"REGRA: {regra} | "
            f"PD={node.proba_bad:.2%} | "
            f"N={node.n_samples} | "
            f"Bads={node.n_bads}"
        )
        return

    self.print_rules(
        node.left,
        conditions + [f"{node.feature} <= {node.threshold:.4f}"]
    )

    self.print_rules(
        node.right,
        conditions + [f"{node.feature} > {node.threshold:.4f}"]
    )
